# Git history is not part of the running app and only adds build-context weight.
.git

# The deps stage installs its own node_modules inside the image.
node_modules

# The builder stage produces its own dist/ output; a stale local one must not leak in.
dist

# Astro's local content/type cache - regenerated by `astro build` itself.
.astro

# Local log files, never needed inside the image.
logs
*.log
