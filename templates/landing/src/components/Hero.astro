---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = "",
  title,
  subtitle = "",
  ctaLabel = "Nous contacter",
  ctaHref = "#contact",
} = Astro.props;
---

<section class="bg-surface px-6 py-24">
  <div class="mx-auto max-w-3xl text-center">
    {
      eyebrow && (
        <p class="mb-3 text-sm font-semibold tracking-wide text-accent uppercase">{eyebrow}</p>
      )
    }
    <h1 class="font-display text-4xl font-bold text-ink sm:text-5xl">{title}</h1>
    {subtitle && <p class="mt-6 text-lg text-muted">{subtitle}</p>}
    <div class="mt-10">
      <a
        href={ctaHref}
        class="inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-surface transition-opacity hover:opacity-90"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</section>
