---
export interface Props {
  heading?: string;
  body?: string;
  imageAlt?: string;
}

const {
  heading = "À propos",
  body = "Présentez ici votre entreprise, votre histoire et ce qui vous distingue.",
  imageAlt = "Illustration de présentation",
} = Astro.props;
---

<section id="a-propos" class="bg-surface px-6 py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-12 sm:grid-cols-2">
    <div>
      <h2 class="font-display text-3xl font-bold text-ink">{heading}</h2>
      <p class="mt-4 text-muted">{body}</p>
    </div>
    <svg
      viewBox="0 0 400 300"
      role="img"
      aria-label={imageAlt}
      class="w-full rounded-lg border border-muted/20 text-muted"
    >
      <rect x="0" y="0" width="400" height="300" fill="currentColor" fill-opacity="0.08" />
      <path
        d="M60 220 L150 110 L220 180 L280 90 L340 220 Z"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <circle cx="120" cy="80" r="24" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
  </div>
</section>
