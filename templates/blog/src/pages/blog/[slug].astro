---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1],
      next: posts[index - 1],
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" });
const canonical = new URL(`/blog/${post.id}/`, Astro.site);
const ogImage = post.data.cover
  ? new URL(post.data.cover.src, Astro.site).toString()
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  ...(ogImage && { image: ogImage }),
  mainEntityOfPage: canonical.toString(),
  author: { "@type": "Organization", name: "{{SITE_TITLE}}" },
  publisher: { "@type": "Organization", name: "{{SITE_TITLE}}" },
};
---

<BaseLayout
  title={`${post.data.title} · {{SITE_TITLE}}`}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  canonical={canonical.toString()}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <header>
      <h1 class="font-display text-4xl font-bold text-ink">{post.data.title}</h1>
      <p class="mt-4 text-sm text-muted">
        <time datetime={post.data.pubDate.toISOString()}>
          {dateFormatter.format(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <>
              {" · "}Mis à jour le{" "}
              <time datetime={post.data.updatedDate.toISOString()}>
                {dateFormatter.format(post.data.updatedDate)}
              </time>
            </>
          )
        }
      </p>
      {
        post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-full border border-accent/30 bg-accent/5 px-3 py-1 text-xs font-semibold text-accent">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          class="mt-8 w-full rounded-lg"
        />
      )
    }

    <div class="post-body mt-10">
      <Content />
    </div>

    <nav
      class="mt-16 flex flex-col gap-4 border-t border-muted/20 pt-8 text-sm sm:flex-row sm:justify-between"
    >
      {
        prev && (
          <a href={`/blog/${prev.id}/`} class="text-accent hover:underline">
            ← Article précédent : {prev.data.title}
          </a>
        )
      }
      {
        next && (
          <a href={`/blog/${next.id}/`} class="text-accent hover:underline sm:text-right">
            Article suivant : {next.data.title} →
          </a>
        )
      }
    </nav>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</BaseLayout>

<style>
  .post-body :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-ink);
  }

  .post-body :global(h3) {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-ink);
  }

  .post-body :global(p) {
    margin-top: 1.25rem;
    color: var(--color-ink);
    line-height: 1.75;
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-top: 1.25rem;
    padding-left: 1.5rem;
    color: var(--color-ink);
  }

  .post-body :global(li) {
    margin-top: 0.5rem;
  }

  .post-body :global(blockquote) {
    margin-top: 1.5rem;
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-muted);
    font-style: italic;
  }

  .post-body :global(code) {
    border-radius: var(--radius-sm);
    background-color: var(--color-muted);
    padding: 0.125rem 0.375rem;
    color: var(--color-surface);
    font-size: var(--text-base);
  }

  .post-body :global(img) {
    margin-top: 1.5rem;
    border-radius: var(--radius-lg);
    width: 100%;
  }
</style>
